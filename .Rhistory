wilcox.test(x = rowMeans(2^log2.peak.cpm[activated.peaks.temp26c.vs.temp10c,paste("k27_temp14",1:3,sep="_")]), y = rowMeans(2^log2.peak.cpm[activated.peaks.temp26c.vs.temp10c,paste("k27_temp20",1:3,sep="_")]),alternative = "greater")
temp26c.vs.temp20c <- topTable(contrast.results, number=nrow(log2.peak.cpm),coef=3,sort.by="logFC")
head(temp26c.vs.temp20c)
peak.ids.26c.20c <- rownames(temp26c.vs.temp20c)
fold.change.26c.20c <- temp26c.vs.temp20c$logFC
q.value.26c.20c <- temp26c.vs.temp20c$adj.P.Val
activated.peaks.temp26c.vs.temp20c <- peak.ids.26c.20c[fold.change.26c.20c > log2(1.5) & q.value.26c.20c < 0.05]
repressed.peaks.temp26c.vs.temp20c <- peak.ids.26c.20c[fold.change.26c.20c < - log2(1.5) & q.value.26c.20c < 0.05]
length(activated.peaks.temp26c.vs.temp20c)
length(repressed.peaks.temp26c.vs.temp20c)
