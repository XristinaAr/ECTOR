wilcox.test(x = rowMeans(expression.matrix[target.genes,paste("T10ºC",1:3,sep="_")]), y = rowMeans(expression.matrix[target.genes,paste("T14ºC",1:3,sep="_")]),alternative = "greater")
wilcox.test(x = rowMeans(expression.matrix[target.genes,paste("T14ºC",1:3,sep="_")]), y = rowMeans(expression.matrix[target.genes,paste("T20ºC",1:3,sep="_")]),alternative = "greater")
