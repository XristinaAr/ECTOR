q.value.14c.10c.with <- temp14c.vs.temp10c.with$adj.P.Val
activated.peaks.temp14c.vs.temp10c.with <- peak.ids.14c.10c.with[fold.change.14c.10c.with > 1 & q.value.14c.10c.with < 0.05]
repressed.peaks.temp14c.vs.temp10c.with <- peak.ids.14c.10c.with[fold.change.14c.10c.with < - 1 & q.value.14c.10c.with < 0.05]
length(activated.peaks.temp14c.vs.temp10c)
length(repressed.peaks.temp14c.vs.temp10c)
