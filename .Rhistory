log2.peak.cpm
peak.names <- paste(paste(peak.cpm$chr, peak.cpm$start, sep = "_"), peak.cpm$end, sep = "_")
log2.peak.cpm <- matrix(data = NA, nrow = nrow(read.counts.k27.temp10c.1), ncol = 12)
colnames(log2.peak.cpm) <- c("k27_temp10_1","k27_temp10_2","k27_temp10_3", "k27_temp14_1","k27_temp14_2","k27_temp14_3","k27_temp20_1","k27_temp20_2","k27_temp20_3","k27_temp26_1","k27_temp26_2","k27_temp26_3")
rownames(log2.peak.cpm) <- peak.names
log2.peak.cpm[,"k27_temp10_1"] <- log2(peak.cpm$k27_temp10_1)
log2.peak.cpm[,"k27_temp10_2"] <- log2(peak.cpm$k27_temp10_2)
log2.peak.cpm[,"k27_temp10_3"] <- log2(peak.cpm$k27_temp10_3)
log2.peak.cpm[,"k27_temp14_1"] <- log2(peak.cpm$k27_temp14_1)
log2.peak.cpm[,"k27_temp14_2"] <- log2(peak.cpm$k27_temp14_2)
log2.peak.cpm[,"k27_temp14_3"] <- log2(peak.cpm$k27_temp14_3)
log2.peak.cpm[,"k27_temp20_1"] <- log2(peak.cpm$k27_temp20_1)
log2.peak.cpm[,"k27_temp20_2"] <- log2(peak.cpm$k27_temp20_2)
log2.peak.cpm[,"k27_temp20_3"] <- log2(peak.cpm$k27_temp20_3)
log2.peak.cpm[,"k27_temp26_1"] <- log2(peak.cpm$k27_temp26_1)
log2.peak.cpm[,"k27_temp26_2"] <- log2(peak.cpm$k27_temp26_2)
log2.peak.cpm[,"k27_temp26_3"] <- log2(peak.cpm$k27_temp26_3)
head(log2.peak.cpm)
library(limma)
experimental.design <- model.matrix(~ -1+factor(c(1,1,1,2,2,2,3,3,3,4,4,4)))
colnames(experimental.design) <- c("k27_temp10",
"k27_temp14",
"k27_temp20",
"k27_temp26")
experimental.design
linear.fit <- lmFit(log2.peak.cpm, experimental.design)
head(log2.peak.cpm)
contrast.matrix <- makeContrasts(k27_temp10-k27_temp20,
k27_temp14-k27_temp20,
k27_temp26-k27_temp20,
levels=c("k27_temp10",
"k27_temp14",
"k27_temp20",
"k27_temp26"))
contrast.linear.fit <- contrasts.fit(linear.fit, contrast.matrix)
contrast.results <- eBayes(contrast.linear.fit)
temp10c.vs.temp20c <- topTable(contrast.results, number=nrow(log2.peak.cpm),coef=1)#,sort.by="logFC")
head(temp10c.vs.temp20c)
peak.ids.10c.20c <- rownames(temp10c.vs.temp20c)
fold.change.10c.20c <- temp10c.vs.temp20c$logFC
q.value.10c.20c <- temp10c.vs.temp20c$adj.P.Val
activated.peaks.temp10c.vs.temp20c <- peak.ids.10c.20c[fold.change.10c.20c > log2(1.5) & q.value.10c.20c < 0.05]
repressed.peaks.temp10c.vs.temp20c <- peak.ids.10c.20c[fold.change.10c.20c < - log2(1.5) & q.value.10c.20c < 0.05]
length(activated.peaks.temp10c.vs.temp20c)
length(repressed.peaks.temp10c.vs.temp20c)
length(repressed.peaks.temp10c.vs.temp20c)/length(peak.names)
temp14c.vs.temp20c <- topTable(contrast.results, number=nrow(log2.peak.cpm),coef=2,sort.by="logFC")
head(temp14c.vs.temp20c)
peak.ids.14c.20c <- rownames(temp14c.vs.temp20c)
fold.change.14c.20c <- temp14c.vs.temp20c$logFC
q.value.14c.20c <- temp14c.vs.temp20c$adj.P.Val
activated.peaks.temp14c.vs.temp20c <- peak.ids.14c.20c[fold.change.14c.20c > log2(1.5) & q.value.14c.20c < 0.05]
repressed.peaks.temp14c.vs.temp20c <- peak.ids.14c.20c[fold.change.14c.20c < - log2(1.5) & q.value.14c.20c < 0.05]
length(activated.peaks.temp14c.vs.temp20c)
length(repressed.peaks.temp14c.vs.temp20c)
length(repressed.peaks.temp14c.vs.temp20c)/length(peak.names)
length(repressed.peaks.temp14c.vs.temp20c)/length(peak.names)
temp26c.vs.temp20c <- topTable(contrast.results, number=nrow(log2.peak.cpm),coef=3,sort.by="logFC")
head(temp26c.vs.temp20c)
peak.ids.26c.20c <- rownames(temp26c.vs.temp20c)
fold.change.26c.20c <- temp26c.vs.temp20c$logFC
q.value.26c.20c <- temp26c.vs.temp20c$adj.P.Val
