normalized.peak.names <- paste(paste(normalized.peak.cpm$chr, normalized.peak.cpm$start, sep = "_"), normalized.peak.cpm$end, sep = "_")
mat.normalized.peak.cpm <- as.matrix(normalized.peak.cpm[,4:15])
rownames(mat.normalized.peak.cpm) <- normalized.peak.names
head(mat.normalized.peak.cpm)
library(limma)
experimental.design <- model.matrix(~ -1+factor(c(1,1,1,2,2,2,3,3,3,4,4,4)))
colnames(experimental.design) <- c("k4_temp10","k4_temp14","k4_temp20","k4_temp26")
experimental.design
linear.fit <- lmFit(mat.normalized.peak.cpm, experimental.design)
contrast.matrix <- makeContrasts(k4_temp10-k4_temp20,k4_temp14-k4_temp20,k4_temp26-k4_temp20,levels=c("k4_temp10","k4_temp14","k4_temp20","k4_temp26"))
contrast.linear.fit <- contrasts.fit(linear.fit, contrast.matrix)
contrast.results <- eBayes(contrast.linear.fit)
temp10c.vs.temp20c <- topTable(contrast.results, number=nrow(mat.normalized.peak.cpm),coef=1,sort.by="logFC")
head(temp10c.vs.temp20c)
peak.ids.10c.20c <- rownames(temp10c.vs.temp20c)
fold.change.10c.20c <- temp10c.vs.temp20c$logFC
q.value.10c.20c <- temp10c.vs.temp20c$adj.P.Val
activated.peaks.temp10c.vs.temp20c <- peak.ids.10c.20c[fold.change.10c.20c > log2(1.5) & q.value.10c.20c < 0.05]
repressed.peaks.temp10c.vs.temp20c <- peak.ids.10c.20c[fold.change.10c.20c < - log2(1.5) & q.value.10c.20c < 0.05]
length(activated.peaks.temp10c.vs.temp20c)
length(repressed.peaks.temp10c.vs.temp20c)
length(activated.peaks.temp10c.vs.temp20c)
length(repressed.peaks.temp10c.vs.temp20c)
