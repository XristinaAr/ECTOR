library(ChIPseeker)
library(TxDb.Otauri.JGI)
txdb <- TxDb.Otauri.JGI
temp26.vs.temp10.peaks <- readPeakFile(peakfile = "chipseq_results/activated.peaks.temp26.vs.temp10.bed",header=FALSE)
promoter <- getPromoters(TxDb=txdb,
upstream=1000,
downstream=1000)
prr5.peakAnno <- annotatePeak(peak = temp26.vs.temp10.peaks,
tssRegion=c(-1000, 1000),
TxDb=txdb)
temp26.vs.temp10.peakAnno <- annotatePeak(peak = temp26.vs.temp10.peaks,
tssRegion=c(-1000, 1000),
TxDb=txdb)
plotAnnoPie(temp26.vs.temp10.peakAnno)
plotAnnoBar(temp26.vs.temp10.peakAnno)
plotDistToTSS(temp26.vs.temp10.peakAnno,
title="Distribution of genomic loci relative to TSS",
ylab = "Genomic Loci (%) (5' -> 3')")
temp26.vs.temp10.annotation <- as.data.frame(temp26.vs.temp10.peakAnno)
head(temp26.vs.temp10.annotation)
target.genes <- temp26.vs.temp10.annotation$geneId[temp26.vs.temp10.annotation$annotation == "Promoter"]
