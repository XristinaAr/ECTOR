temp26.vs.temp10.peaks <- readPeakFile(peakfile = "chipseq_results/h3k27me3/limma.k27.activated.peaks.temp26.vs.temp10.bed",header=FALSE)
promoter <- getPromoters(TxDb=txdb,
upstream=1000,
downstream=1000)
