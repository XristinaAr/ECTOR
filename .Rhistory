contrast.matrix.k4 <- makeContrasts(k4_temp14-k4_temp10,k4_temp20-k4_temp10,k4_temp26-k4_temp10,
levels=c("k4_temp10","k4_temp14","k4_temp20","k4_temp26"))
contrast.linear.fit.k4 <- contrasts.fit(linear.fit.k4, contrast.matrix.k4)
contrast.results.k4 <- eBayes(contrast.linear.fit.k4)
temp14c.vs.temp10c.k4 <- topTable(contrast.results.k4, number=nrow(normalized.peak.cpm.k4),coef=1,sort.by="logFC")
head(temp14c.vs.temp10c.k4)
peak.ids.14c.10c.k4 <- rownames(temp14c.vs.temp10c.k4)
fold.change.14c.10c.k4 <- temp14c.vs.temp10c.k4$logFC
q.value.14c.10c.k4 <- temp14c.vs.temp10c.k4$adj.P.Val
activated.peaks.temp14c.vs.temp10c.k4 <- peak.ids.14c.10c.k4[fold.change.14c.10c.k4 > 1 & q.value.14c.10c.k4 < 0.05]
repressed.peaks.temp14c.vs.temp10c.k4 <- peak.ids.14c.10c.k4[fold.change.14c.10c.k4 < - 1 & q.value.14c.10c.k4 < 0.05]
