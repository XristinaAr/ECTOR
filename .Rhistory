log2.peak.cpm <- matrix(data = NA, nrow = nrow(read.counts.k27.temp10c.1), ncol = 14)
colnames(log2.peak.cpm) <- c("k27_temp10_1","k27_temp10_2","k27_temp10_3", "k27_temp14_1","k27_temp14_2","k27_temp14_3","k27_temp20_1","k27_temp20_zt8_1","k27_temp20_zt8_2","k27_temp20_zt16_1","k27_temp20_zt16_2","k27_temp26_1","k27_temp26_2","k27_temp26_3")
rownames(log2.peak.cpm) <- peak.names
log2.peak.cpm[,"k27_temp10_1"] <- log2(peak.cpm$k27_temp10_1)
log2.peak.cpm[,"k27_temp10_2"] <- log2(peak.cpm$k27_temp10_2)
log2.peak.cpm[,"k27_temp10_3"] <- log2(peak.cpm$k27_temp10_3)
