repressed.peaks.temp20rep1.vs.10  <- peak.ids.temp20.vs.10[fold.change.temp20.vs.10 < - 1 & q.value.temp20rep1.vs.10 < 0.05]
length(activated.peaks.temp20rep1.vs.10)
length(repressed.peaks.temp20rep1.vs.10)
