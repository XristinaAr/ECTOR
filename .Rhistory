peak.annotation.26.20.k4[i] <- "TES"
} else if(nrow(inside.gene.body) > 0)
{
activated.genes.26.20.k4[i] <- paste(unlist(inside.gene.body$gene_id),collapse = ",")
peak.annotation.26.20.k4[i] <- "internal.gene.body"
} else
{
peak.annotation.26.20.k4[i] <- "intergenic"
}
}
temp26vs20.peak.annotation.activated.k4 <- cbind(activated.peaks.26vs20.k4,data.frame(peak.annotation.26.20.k4,activated.genes.26.20.k4))
head(temp26vs20.peak.annotation.activated.k4)
write.table(x = temp26vs20.peak.annotation.activated.k4,file = "tables/H3K4me3_activated_26vs20_peak_annotation.tsv",quote = F,sep = "\t",row.names = F)
all.k4.activated.26vs20.genes <- (unlist(sapply(X =temp26vs20.peak.annotation.activated.k4$activated.genes.26.20.k4,
FUN = function(x) {strsplit(x,",")[[1]]})))
