for(i in 1:nrow(repressed.peaks.10vs20.k27))
{
current.chr <- repressed.peaks.10vs20.k27[i,1]
current.start <- repressed.peaks.10vs20.k27[i,2]
current.end <- repressed.peaks.10vs20.k27[i,3]
complete.gene.body <- subset(ostta.genes,
seqnames == current.chr &
start >= current.start &
end <= current.end)
overlap.tss.pos.strand <- subset(ostta.genes,
seqnames == current.chr &
start >= current.start & start <= current.end &
strand == "+")
overlap.tss.neg.strand <- subset(ostta.genes,
seqnames == current.chr &
end >= current.start & end <= current.end &
strand == "-")
overlap.tes.pos.strand <- subset(ostta.genes,
seqnames == current.chr &
end >= current.start & end <= current.end &
strand == "+")
overlap.tes.neg.strand <- subset(ostta.genes,
seqnames == current.chr &
start >= current.start & start <= current.end &
strand == "-")
inside.gene.body <- subset(ostta.genes, seqnames == current.chr &
start <= current.start & end >= current.end)
if(nrow(complete.gene.body) > 0)
{
repressed.peaks.10vs20.k27[i] <- paste(unlist(complete.gene.body$gene_id),collapse = ",")
peak.annotation.10.20.k27[i] <- "gene.body"
} else if(nrow(overlap.tss.pos.strand) > 0)
{
repressed.peaks.10vs20.k27[i] <- paste(unlist(overlap.tss.pos.strand$gene_id),collapse = ",")
peak.annotation.10.20.k27[i] <- "TSS"
} else if(nrow(overlap.tss.neg.strand) > 0)
{
repressed.peaks.10vs20.k27[i] <- paste(unlist(overlap.tss.neg.strand$gene_id),collapse = ",")
peak.annotation.10.20.k27[i] <- "TSS"
} else if(nrow(overlap.tes.pos.strand) > 0)
{
repressed.peaks.10vs20.k27[i] <- paste(unlist(overlap.tes.pos.strand$gene_id),collapse = ",")
peak.annotation.10.20.k27[i] <- "TES"
} else if(nrow(overlap.tes.neg.strand) > 0)
{
repressed.peaks.10vs20.k27[i] <- paste(unlist(overlap.tes.neg.strand$gene_id),collapse = ",")
peak.annotation.10.20.k27[i] <- "TES"
} else if(nrow(inside.gene.body) > 0)
{
repressed.peaks.10vs20.k27[i] <- paste(unlist(inside.gene.body$gene_id),collapse = ",")
peak.annotation.10.20.k27[i] <- "internal.gene.body"
} else
{
peak.annotation.10.20.k27[i] <- "intergenic"
}
}
