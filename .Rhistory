library(limma)
experimental.design <- model.matrix(~ -1+factor(c(1,1,2,2)))
colnames(experimental.design) <- c("k27_temp20_ld_zt8",
"k27_temp20_ld_zt16")
experimental.design
linear.fit <- lmFit(log2.peak.cpm, experimental.design)
contrast.matrix <- makeContrasts(k27_temp20_ld_zt8-k27_temp20_ld_zt16,
levels=c("k27_temp20_ld_zt8",
"k27_temp20_ld_zt16"))
contrast.linear.fit <- contrasts.fit(linear.fit, contrast.matrix)
contrast.results <- eBayes(contrast.linear.fit)
k27.zt8.vs.zt16 <- topTable(contrast.results, number=nrow(log2.peak.cpm),coef=1,sort.by="logFC")
head(k27.zt8.vs.zt16)
peak.ids.k27.zt8.vs.zt16 <- rownames(k27.zt8.vs.zt16)
fold.change.k27.zt8.vs.zt16 <- k27.zt8.vs.zt16$logFC
q.value.k27.zt8.vs.zt16 <- k27.zt8.vs.zt16$adj.P.Val
activated.peaks.k27.zt8.vs.zt16 <- peak.ids.k27.zt8.vs.zt16[fold.change.k27.zt8.vs.zt16 > 1 & q.value.k27.zt8.vs.zt16 < 0.05]
repressed.peaks.k27.zt8.vs.zt16  <- peak.ids.k27.zt8.vs.zt16[fold.change.k27.zt8.vs.zt16 < - 1 & q.value.k27.zt8.vs.zt16 < 0.05]
length(activated.peaks.k27.zt8.vs.zt16)
length(repressed.peaks.k27.zt8.vs.zt16)
