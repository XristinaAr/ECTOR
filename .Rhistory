activated.genes.26.10 <- vector(mode = "character",length = nrow(activated.peaks.26vs10))
peak.annotation <- vector(mode = "character",length = nrow(activated.peaks.26vs10))
peak.annotation.26.10 <- vector(mode = "character",length = nrow(activated.peaks.26vs10))
for(i in 1:nrow(activated.peaks.26vs10))
{
current.chr <- activated.peaks.26vs10[i,1]
current.start <- activated.peaks.26vs10[i,2]
current.end <- activated.peaks.26vs10[i,3]
complete.gene.body <- subset(ostta.genes,
seqnames == current.chr &
start >= current.start &
end <= current.end)
overlap.tss.pos.strand <- subset(ostta.genes,
seqnames == current.chr &
start >= current.start & start <= current.end &
strand == "+")
overlap.tss.neg.strand <- subset(ostta.genes,
seqnames == current.chr &
end >= current.start & end <= current.end &
strand == "-")
overlap.tes.pos.strand <- subset(ostta.genes,
seqnames == current.chr &
end >= current.start & end <= current.end &
strand == "+")
overlap.tes.neg.strand <- subset(ostta.genes,
seqnames == current.chr &
start >= current.start & start <= current.end &
strand == "-")
inside.gene.body <- subset(ostta.genes, seqnames == current.chr &
start <= current.start & end >= current.end)
if(nrow(complete.gene.body) > 0)
{
activated.genes.26.10[i] <- paste(unlist(complete.gene.body$gene_id),collapse = ",")
peak.annotation.26.10[i] <- "gene.body"
} else if(nrow(overlap.tss.pos.strand) > 0)
{
activated.genes.26.10[i] <- paste(unlist(overlap.tss.pos.strand$gene_id),collapse = ",")
peak.annotation.26.10[i] <- "TSS"
} else if(nrow(overlap.tss.neg.strand) > 0)
{
activated.genes.26.10[i] <- paste(unlist(overlap.tss.neg.strand$gene_id),collapse = ",")
peak.annotation.26.10[i] <- "TSS"
} else if(nrow(overlap.tes.pos.strand) > 0)
{
activated.genes.26.10[i] <- paste(unlist(overlap.tes.pos.strand$gene_id),collapse = ",")
peak.annotation.26.10[i] <- "TES"
} else if(nrow(overlap.tes.neg.strand) > 0)
{
activated.genes.26.10[i] <- paste(unlist(overlap.tes.neg.strand$gene_id),collapse = ",")
peak.annotation.26.10[i] <- "TES"
} else if(nrow(inside.gene.body) > 0)
{
activated.genes.26.10[i] <- paste(unlist(inside.gene.body$gene_id),collapse = ",")
peak.annotation.26.10[i] <- "internal.gene.body"
} else
{
peak.annotation.26.10[i] <- "intergenic"
}
}
activated.genes.26.10
peak.annotation.26.10
