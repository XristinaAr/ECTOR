contrast.matrix <- makeContrasts(k27_temp14-k27_temp10,k27_temp20_ll-k27_temp10,k27_temp26-k27_temp10,k27_temp20_ll-k27_temp20_ld, levels=c("k27_temp10","k27_temp14","k27_temp20_ll","k27_temp20_ld","k27_temp26"))
contrast.linear.fit <- contrasts.fit(linear.fit, contrast.matrix)
contrast.results <- eBayes(contrast.linear.fit)
temp14.vs.10 <- topTable(contrast.results, number=nrow(log2.peak.cpm),coef=1,sort.by="logFC")
head(temp14.vs.10)
peak.ids.temp14.vs.10 <- rownames(temp14.vs.10)
fold.change.temp14.vs.10 <- temp14.vs.10$logFC
q.value.temp14.vs.10 <- temp14.vs.10$adj.P.Val
activated.peaks.temp14.vs.10  <- peak.ids.temp14.vs.10[fold.change.temp14.vs.10 > 1 & q.value.temp14.vs.10 < 0.05]
repressed.peaks.temp14.vs.10  <- peak.ids.temp14.vs.10[q.value.temp14.vs.10 < - 1 & q.value.temp14.vs.10 < 0.05]
length(activated.peaks.temp14.vs.10)
length(repressed.peaks.temp14.vs.10)
View(temp26.vs.10)
