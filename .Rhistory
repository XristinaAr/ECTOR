matrix.activated.peaks.temp26c.vs.temp10c.k27 <- as.matrix(t(as.data.frame(strsplit(x = activated.peaks.temp26c.vs.temp20c.k27, split = "_"))))
rownames(matrix.activated.peaks.temp26c.vs.temp10c.k27) <- NULL
