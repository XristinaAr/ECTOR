peak.ids.26c.10c.with <- rownames(temp26c.vs.temp10c.with)
fold.change.26c.10c.with <- temp26c.vs.temp10c.with$logFC
q.value.26c.10c.with <- temp26c.vs.temp10c.with$adj.P.Val
activated.peaks.temp26c.vs.temp10c.with <- peak.ids.26c.10c.with[fold.change.26c.10c.with > 1 & q.value.26c.10c.with < 0.05]
repressed.peaks.temp26c.vs.temp10c.with <- peak.ids.26c.10c.with[fold.change.26c.10c.with < - 1 & q.value.26c.10c.with < 0.05]
