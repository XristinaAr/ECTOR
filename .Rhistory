start <= current.start & end >= current.end)
if(nrow(complete.gene.body) > 0)
{
repressed.genes.14.20.k4[i] <- paste(unlist(complete.gene.body$gene_id),collapse = ",")
peak.annotation.14.20.k4[i] <- "gene.body"
} else if((nrow(overlap.tss.pos.strand) > 0) | (nrow(overlap.tss.neg.strand) > 0))
{
repressed.genes.14.20.k4[i] <- paste(c(unlist(overlap.tss.pos.strand$gene_id),
unlist(overlap.tss.neg.strand$gene_id)),collapse = ",")
peak.annotation.14.20.k4[i] <- "TSS"
} else if(nrow(overlap.tes.pos.strand) > 0)
{
repressed.genes.14.20.k4[i] <- paste(unlist(overlap.tes.pos.strand$gene_id),collapse = ",")
peak.annotation.14.20.k4[i] <- "TES"
} else if(nrow(overlap.tes.neg.strand) > 0)
{
repressed.genes.14.20.k4[i] <- paste(unlist(overlap.tes.neg.strand$gene_id),collapse = ",")
peak.annotation.14.20.k4[i] <- "TES"
} else if(nrow(inside.gene.body) > 0)
{
repressed.genes.14.20.k4[i] <- paste(unlist(inside.gene.body$gene_id),collapse = ",")
peak.annotation.14.20.k4[i] <- "internal.gene.body"
} else
{
peak.annotation.14.20.k4[i] <- "intergenic"
}
}
temp14vs20.peak.annotation.repressed.k4 <- cbind(repressed.peaks.14vs20.k4,data.frame(peak.annotation.14.20.k4,repressed.genes.14.20.k4))
head(temp10vs20.peak.annotation.repressed.k4)
write.table(x = temp10vs20.peak.annotation.repressed.k4,file = "tables/H3K4me3_repressed_10vs20_peak_annotation.tsv",quote = F,sep = "\t",row.names = F)
all.k4.repressed.10vs20.genes <- (unlist(sapply(X =temp10vs20.peak.annotation.repressed.k4$repressed.genes.10.20.k4,
FUN = function(x) {strsplit(x,",")[[1]]})))
names(all.k4.repressed.10vs20.genes) <- NULL
write.table(x = all.k4.repressed.10vs20.genes,file = "tables/H3K4me3_repressed_10vs20_genes.tsv",quote = F,sep = "\t",row.names = F)
length(all.k4.repressed.10vs20.genes)
length(all.k4.repressed.10vs20.genes)/7668
temp14vs20.peak.annotation.repressed.k4 <- cbind(repressed.peaks.14vs20.k4,data.frame(peak.annotation.14.20.k4,repressed.genes.14.20.k4))
head(temp14vs20.peak.annotation.repressed.k4)
write.table(x = temp14vs20.peak.annotation.repressed.k4,file = "tables/H3K4me3_repressed_14vs20_peak_annotation.tsv",quote = F,sep = "\t",row.names = F)
all.k4.repressed.14vs20.genes <- (unlist(sapply(X =temp14vs20.peak.annotation.repressed.k4$repressed.genes.14.20.k4,
