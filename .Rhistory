"k27_temp14",
"k27_temp20_ll",
"k27_temp20_ld",
"k27_temp24",
"k27_temp26"))
contrast.linear.fit.with <- contrasts.fit(linear.fit.with, contrast.matrix.with)
contrast.results.with <- eBayes(contrast.linear.fit.with)
