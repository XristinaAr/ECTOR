length(activated.peaks.temp14c.vs.temp20c.k4)
length(repressed.peaks.temp14c.vs.temp20c.k4)
length(activated.peaks.temp14c.vs.temp20c.k4)/length(peak.names)
length(repressed.peaks.temp14c.vs.temp20c.k4)/length(peak.names)
wilcox.test(x = rowMeans(2^log2.peak.cpm.k4[repressed.peaks.temp10c.vs.temp20c.k4,paste("k27_temp10",1:3,sep="_")]), y = rowMeans(2^log2.peak.cpm.k4[repressed.peaks.temp10c.vs.temp20c.k4,paste("k27_temp20",1:3,sep="_")]),alternative = "less")
wilcox.test(x = rowMeans(2^log2.peak.cpm.k4[repressed.peaks.temp10c.vs.temp20c.k4,paste("k4_temp10",1:3,sep="_")]), y = rowMeans(2^log2.peak.cpm.k4[repressed.peaks.temp10c.vs.temp20c.k4,paste("k4_temp20",1:3,sep="_")]),alternative = "less")
wilcox.test(x = rowMeans(2^log2.peak.cpm.k4[repressed.peaks.temp14c.vs.temp20c.k4,paste("k4_temp14",1:3,sep="_")]), y = rowMeans(2^log2.peak.cpm.k4[repressed.peaks.temp14c.vs.temp20c.k4,paste("k4_temp20",1:3,sep="_")]),alternative = "less")
wilcox.test(x = rowMeans(2^log2.peak.cpm.k4[activated.peaks.temp26c.vs.temp20c.k4,paste("k4_temp26",1:3,sep="_")]), y = rowMeans(2^log2.peak.cpm.k4[activated.peaks.temp26c.vs.temp20c.k4,paste("k4_temp20",1:3,sep="_")]),alternative = "greater")
boxplot(rowMeans(2^log2.peak.cpm.k4[repressed.peaks.temp10c.vs.temp20c.k4,paste("k4_temp10",1:3,sep="_")]),
rowMeans(2^log2.peak.cpm.k4[repressed.peaks.temp10c.vs.temp20c.k4,paste("k4_temp14",1:3,sep="_")]),
rowMeans(2^log2.peak.cpm.k4[repressed.peaks.temp10c.vs.temp20c.k4,paste("k4_temp20",1:3,sep="_")]),outline=F,col=c("#00FFFF","#6699FF", "#CC33FF"),ylab="CPM",names=c("10ºC","14ºC","20ºC"),las=2,cex.lab=1.3)
boxplot(
rowMeans(2^log2.peak.cpm.k4[activated.peaks.temp26c.vs.temp20c.k4,paste("k4_temp20",1:3,sep="_")]),
rowMeans(2^log2.peak.cpm.k4[activated.peaks.temp26c.vs.temp20c.k4,paste("k4_temp26",1:3,sep="_")]),outline=F,col=c("#CC33FF", "#FF0000"),ylab="CPM",names=c("20ºC","26ºC"),las=2,cex.lab=1.3)
jpeg(filename = "images/k4_dif_occupation_26vs20_barplot.jpg",res = 250,width = 600,height = 1000)
boxplot(
rowMeans(2^log2.peak.cpm.k4[activated.peaks.temp26c.vs.temp20c.k4,paste("k4_temp20",1:3,sep="_")]),
rowMeans(2^log2.peak.cpm.k4[activated.peaks.temp26c.vs.temp20c.k4,paste("k4_temp26",1:3,sep="_")]),outline=F,col=c("#CC33FF", "#FF0000"),ylab="CPM",names=c("20ºC","26ºC"),las=2,cex.lab=1.3)
