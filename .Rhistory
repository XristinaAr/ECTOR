contrast.matrix <- makeContrasts(k27_temp10-k27_temp20,k27_temp14-k27_temp20,k27_temp26-k27_temp20,levels=c("k27_temp10","k27_temp14","k27_temp20","k27_temp26"))
contrast.linear.fit <- contrasts.fit(linear.fit, contrast.matrix)
contrast.results <- eBayes(contrast.linear.fit)
temp10c.vs.temp20c <- topTable(contrast.results, number=nrow(log2.peak.cpm),coef=1,sort.by="logFC")
head(temp10c.vs.temp20c)
peak.ids.10c.20c <- rownames(temp10c.vs.temp20c)
fold.change.10c.20c <- temp10c.vs.temp20c$logFC
q.value.10c.20c <- temp10c.vs.temp20c$adj.P.Val
activated.peaks.temp10c.vs.temp20c <- peak.ids.10c.20c[fold.change.10c.20c > 1 & q.value.10c.20c < 0.05]
repressed.peaks.temp10c.vs.temp20c <- peak.ids.10c.20c[fold.change.10c.20c < - 1 & q.value.10c.20c < 0.05]
activated.peaks.temp10c.vs.temp20c.1.5 <- peak.ids.10c.20c[fold.change.10c.20c > log2(1.5) & q.value.10c.20c < 0.05]
repressed.peaks.temp10c.vs.temp20c.1.5 <- peak.ids.10c.20c[fold.change.10c.20c < - log2(1.5) & q.value.10c.20c < 0.05]
length(activated.peaks.temp10c.vs.temp20c)
