experimental.design.with
linear.fit.with <- lmFit(log2.peak.cpm.with, experimental.design.with)
contrast.matrix.with <- makeContrasts(k27_temp14-k27_temp10,k27_temp20-k27_temp10,k27_temp26-k27_temp10,levels=c("k27_temp10","k27_temp14","k27_temp20","k27_temp26"))
contrast.linear.fit.with <- contrasts.fit(linear.fit, contrast.matrix)
contrast.results.with <- eBayes(contrast.linear.fit)
temp14c.vs.temp10c.with <- topTable(contrast.results.with, number=nrow(log2.peak.cpm.with),coef=1,sort.by="logFC")
