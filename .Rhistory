library(limma)
experimental.design <- model.matrix(~ -1+factor(c(1,1,1,2,2,2,3,3,3,4,4,4)))
colnames(experimental.design) <- c("k27_temp10",
"k27_temp14",
"k27_temp20",
"k27_temp26")
experimental.design
linear.fit.k27 <- lmFit(log2.peak.cpm, experimental.design)
head(log2.peak.cpm)
contrast.matrix.k27 <- makeContrasts(k27_temp10-k27_temp20,
k27_temp14-k27_temp20,
k27_temp26-k27_temp20,
levels=c("k27_temp10",
"k27_temp14",
"k27_temp20",
"k27_temp26"))
contrast.linear.fit.k27 <- contrasts.fit(linear.fit.k27, contrast.matrix.k27)
contrast.results.k27 <- eBayes(contrast.linear.fit.k27)
temp10c.vs.temp20c.k27 <- topTable(contrast.results.k27, number=nrow(log2.peak.cpm),coef=1)#,sort.by="logFC")
head(temp10c.vs.temp20c.k27)
peak.ids.10c.20c <- rownames(temp10c.vs.temp20c.k27)
fold.change.10c.20c.k27 <- temp10c.vs.temp20c.k27$logFC
q.value.10c.20c.k27 <- temp10c.vs.temp20c.k27$adj.P.Val
activated.peaks.temp10c.vs.temp20c.k27 <- peak.ids.10c.20c[fold.change.10c.20c.k27 > log2(1.5) & q.value.10c.20c.k27 < 0.05]
repressed.peaks.temp10c.vs.temp20c.k27 <- peak.ids.10c.20c[fold.change.10c.20c.k27 < - log2(1.5) & q.value.10c.20c.k27 < 0.05]
length(activated.peaks.temp10c.vs.temp20c.k27)
length(repressed.peaks.temp10c.vs.temp20c.k27)
length(activated.peaks.temp10c.vs.temp20c.k27)/length(peak.names)
length(repressed.peaks.temp10c.vs.temp20c.k27)/length(peak.names)
