#gradico de red: representa tanto genes como funciones biológicas como nodos,
#y las conexiones entre ellos reflejan las relaciones o asociaciones en el
#contexto del análisis de enriquecimiento funcional.
#el gráfico de red muestra las interacciones entre genes y funciones biológicas enriquecidas,
#lo que permite visualizar cómo están relacionados entre sí. Esto puede ayudar a
#comprender mejor las funciones biológicas asociadas a los genes enriquecidos y a
#identificar posibles relaciones funcionales entre ellos.
repressed.enrich.go <- enrichGO(gene          = repressed.genes,
OrgDb         = org.Dm.eg.db,
ont           = "BP",
pAdjustMethod = "BH",
pvalueCutoff  = 0.05,
readable      = FALSE,
keyType = "FLYBASE")
barplot(repressed.enrich.go,showCategory = 20)
dotplot(repressed.enrich.go,showCategory = 20)
barplot(repressed.enrich.go,showCategory = 20)
barplot(repressed.enrich.go,showCategory = 20)
dotplot(repressed.enrich.go,showCategory = 20)
emapplot(pairwise_termsim(repressed.enrich.go),showCategory = 20)
cnetplot(repressed.enrich.go,showCategory = 20)
treeplot(pairwise_termsim(repressed.enrich.go),showCategory = 20)
repressed.enrich.kegg <- enrichKEGG(gene  = repressed.genes,
organism = "dme",
pAdjustMethod = "BH",
pvalueCutoff  = 0.05,
keyType = "FlyBase")
repressed.enrich.kegg
